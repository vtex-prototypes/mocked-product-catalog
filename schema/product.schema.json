{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vtex/mocked-product-catalog/schema/product.schema.json",
  "title": "Product",
  "description": "One product in the mock catalog. Lives in products/<id>.json; images live in images/<id>/. Every human-readable string is localized (en + pt-BR) and every price is given in BRL and USD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "categoryId", "description", "price", "availability", "tags", "images"],
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt-BR"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "pt-BR": { "type": "string", "minLength": 1 }
      }
    },
    "localizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "pt-BR"],
      "properties": {
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pt-BR": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BRL", "USD"],
      "properties": {
        "BRL": { "type": "number", "exclusiveMinimum": 0 },
        "USD": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "kebab-case slug in English. Must match the file name and the images folder."
    },
    "brand": { "type": "string", "minLength": 1, "description": "Fictional brand. Never use a real brand." },
    "categoryId": { "type": "string", "description": "An id from categories.json." },
    "name": {
      "$ref": "#/$defs/localized",
      "description": "Long, marketplace-style listing name (brand, product, size, material, color, key features). At least 60 characters per locale."
    },
    "description": {
      "$ref": "#/$defs/localized",
      "description": "Two or three sentences. At least 80 characters per locale."
    },
    "price": { "$ref": "#/$defs/money", "description": "Current selling price in each currency." },
    "listPrice": {
      "$ref": "#/$defs/money",
      "description": "Pre-discount price. Only set it when the product is on sale; each currency must be greater than the matching price."
    },
    "availability": { "type": "string", "enum": ["in_stock", "low_stock", "out_of_stock"] },
    "tags": { "$ref": "#/$defs/localizedList" },
    "images": {
      "type": "array",
      "minItems": 1,
      "description": "First entry is the main image.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "alt"],
        "properties": {
          "file": { "type": "string", "pattern": "^\\d+\\.png$", "description": "Numbered PNG inside images/<id>/, e.g. 1.png" },
          "alt": { "$ref": "#/$defs/localized" }
        }
      }
    }
  }
}
